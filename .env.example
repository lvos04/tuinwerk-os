# Development reference only. On TrueNAS enter these values in Custom App fields.
# Never commit a real .env, password, signing key or provider credential.
DATABASE_URL=postgresql://tuinwerk:replace-with-a-local-password@localhost:5432/tuinwerk
PORT=3001
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Europe/Amsterdam
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_BYTES=10485760
RECURRENCE_LOOKAHEAD_DAYS=28
# Bootstrap only. Remove ADMIN_PASSWORD after creating the first administrator.
ADMIN_EMAIL=
ADMIN_NAME=Beheerder
ADMIN_PASSWORD=
# Optional admin second factor: independently backed-up random 64 hexadecimal chars.
TOTP_ENCRYPTION_KEY=
# External services are off until explicitly configured.
AI_ENABLED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_DAILY_TOKEN_BUDGET=10000
AI_DAILY_BUDGET_EUR=1
AI_INPUT_EUR_PER_MILLION=
AI_OUTPUT_EUR_PER_MILLION=
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AGE_RECIPIENT=
BACKUP_INTERVAL_SECONDS=86400
RCLONE_DEST=
# The following settings are only for the optional local Compose test fixture.
POSTGRES_PASSWORD=replace-with-at-least-32-random-hex-characters
APP_HOST=tuinwerk.example.nl
APP_VERSION=local
DATA_ROOT=/mnt/pool/apps/tuinwerk
HTTP_PORT=80
HTTPS_PORT=443
# Custom App backup pruning is opt-in; dry run is the default.
BACKUP_RETENTION_APPLY=false
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
