{
  "cli": {
    "version": "27.7.2",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0",
        "simulator": false
      }
    },
    "android-apk": {
      "extends": "production",
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "android-apk"
    },
    "testflight": {
      "extends": "production"
    },
    "simulator": {
      "extends": "production",
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
